# Copy to .env and fill in. Set the same keys in Vercel → Project → Settings →
# Environment Variables (except ADMIN_*, which are only used locally).

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me

DEBUG=True

TIME_ZONE=Asia/Dhaka
CURRENCY_SYMBOL=৳

# Supabase → Connect. Both environments use the pooler; only the port differs:
#   Locally / for migrations : SESSION pooler,     port 5432
#   On Vercel                : TRANSACTION pooler, port 6543
# Avoid the direct host (db.<ref>.supabase.co) — it is IPv6-only, so it fails
# with "could not translate host name" on an IPv4 network.
# Note the username is postgres.<project-ref>, not plain postgres.
# Leave unset to develop against local SQLite.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# Your deployed URL, needed for CSRF on form posts (e.g. https://my-meal.vercel.app)
SITE_URL=

# Used only by: python manage.py bootstrap_admin
ADMIN_USERNAME=ratul
ADMIN_PASSWORD=change-this
ADMIN_EMAIL=ratulhasan1644@gmail.com

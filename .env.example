# Copy to .env and fill in. Set the same keys in Vercel → Project → Settings →
# Environment Variables (except ADMIN_*, which are only used locally).

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me

DEBUG=True

TIME_ZONE=Asia/Dhaka
CURRENCY_SYMBOL=৳

# Supabase → Project Settings → Database → Connection string.
#   Locally / for migrations : DIRECT connection, port 5432
#   On Vercel                : TRANSACTION POOLER, port 6543
# Serverless exhausts direct connections, and the pooler is unreliable for
# schema changes — so the two environments use different URLs.
# Leave unset to develop against local SQLite.
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Your deployed URL, needed for CSRF on form posts (e.g. https://my-meal.vercel.app)
SITE_URL=

# Used only by: python manage.py bootstrap_admin
ADMIN_USERNAME=ratul
ADMIN_PASSWORD=change-this
ADMIN_EMAIL=ratulhasan1644@gmail.com

# Copy to .env for local development. Set the same keys in Vercel → Project → Environment Variables.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me

DEBUG=True

# Supabase → Project Settings → Database → Connection string → Transaction pooler (port 6543).
# Leave unset locally to fall back to SQLite.
DATABASE_URL=postgresql://postgres.btmkbhgvxonznlgoaxgn:YOUR-PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres

# Your deployed URL, for CSRF (e.g. https://my-meal.vercel.app)
SITE_URL=

TIME_ZONE=Asia/Dhaka
CURRENCY_SYMBOL=৳

# Used only by `python manage.py bootstrap_admin`
ADMIN_USERNAME=ratul
ADMIN_PASSWORD=change-this
ADMIN_EMAIL=ratulhasan1644@gmail.com
